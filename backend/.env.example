# Both modes require a service access token (not the model API key).
SERVICE_TOKEN=replace-with-random-long-token
PROVIDER=mock
# Real provider: explicitly set PROVIDER=openai, credentials, and a vision+structured model.
OPENAI_API_KEY=
# Officially verified compatible example; choose a model available to your API account.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=45
MAX_IMAGE_BYTES=8388608
REQUESTS_PER_MINUTE=20
