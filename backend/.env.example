# All modes require a service access token (not the model API key).
SERVICE_TOKEN=replace-with-random-long-token
PROVIDER=mock
# Real modes: openai or deepseek; neither falls back to Mock.
# Real provider: explicitly set PROVIDER=openai, credentials, and a vision+structured model.
OPENAI_API_KEY=
# Officially verified compatible example; choose a model available to your API account.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# DeepSeek official Responses API; key stays on the backend only.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Optional: when plan model is text-only, use deepseek-flash for photos.
DEEPSEEK_VISION_MODEL=
AI_MAX_OUTPUT_TOKENS=12000
AI_TIMEOUT_SECONDS=45
MAX_IMAGE_BYTES=8388608
REQUESTS_PER_MINUTE=20
# Single-worker limits. Rejected busy requests are not queued or retried automatically.
AI_MAX_CONCURRENT_REQUESTS=2
REQUEST_BODY_TIMEOUT_SECONDS=15
